# Database
CRM_ENV=production
DB_HOST=localhost
# Optional; leave empty for the default MySQL port 3306.
DB_PORT=
DB_NAME=repair_crm
DB_USER=repair_crm_app
DB_PASS=replace-with-a-long-random-password
# CLI deployment account: schema changes only; never used by web requests.
DB_MIGRATION_USER=repair_crm_migrator
DB_MIGRATION_PASS=replace-with-a-separate-long-random-password
# Generate once with: php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
# Keep the same value for the lifetime of encrypted device PIN data.
CRM_DATA_ENCRYPTION_KEY=
# Set to 1 only when a trusted TLS-terminating reverse proxy supplies X-Forwarded-Proto.
CRM_TRUST_PROXY_HTTPS=0
# PHP and MySQL session timezone for report periods. Set it to the zone the existing data was written in.
CRM_TIMEZONE=Europe/Prague
# Public HTTPS origin used in QR codes and customer status links (never taken from the Host header).
CRM_PUBLIC_BASE_URL=https://app.servis.expert
# Optional absolute path for SQL dumps. Default is <app>/backup_db/ (inside the web tree, denied by .htaccess).
# CRM_BACKUP_DIR=/absolute/path/outside/webroot/backups

# Telegram Bot (optional)
TG_BOT_TOKEN=
# Full HTTPS URL of tg_webhook.php. Required when Telegram notifications are enabled.
TELEGRAM_WEBHOOK_URL=https://crm.example.com/tg_webhook.php
# Generate a random 32+ character value using only A-Z, a-z, 0-9, _ and -.
TELEGRAM_WEBHOOK_SECRET=

# AI Integration (optional)
AI_API_KEY=
AI_MODEL=google/gemini-2.0-flash-001
AI_PROVIDER=openrouter

# MyInvoice.cz API integration
MYINVOICE_API_BASE_URL=https://fakturace.43.157.31.121.sslip.io
MYINVOICE_API_TOKEN=
MYINVOICE_ENABLED=1
MYINVOICE_AUTO_ISSUE=1
MYINVOICE_DEFAULT_COUNTRY_ID=1
MYINVOICE_DEFAULT_STREET=-
MYINVOICE_DEFAULT_CITY=Praha
MYINVOICE_DEFAULT_ZIP=11000
MYINVOICE_DEFAULT_LANGUAGE=cs
# Optional: used only when a CRM customer has no email, because MyInvoice requires one.
MYINVOICE_FALLBACK_EMAIL=
