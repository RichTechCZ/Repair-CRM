# ── Block debug / test / maintenance scripts from public web access ─────────
<FilesMatch "^(debug_check|debug_reports|test|analyze_import|find_missing|parse_new_dump|verify_migration|set_tg|run_migrations)\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Block sensitive data files ───────────────────────────────────────────────
<FilesMatch "\.(env|log|sql|md|ndjson|xlsx|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ── Deny access to backup / temp / tools paths ───────────────────────────────
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(backup_db|crm_backups|temp|tools|memory|graphify-out|outputs|facktura|tests|migrations|\.claude|\.agents|\.codebase-memory|\.playwright-cli|\.githooks|\.github)/ - [F,L]
    RewriteRule ^crm_.*_redesign\.html$ - [F,L]
    RewriteRule ^clear_database\.sql$ - [F,L]
</IfModule>

# ── Security headers ─────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ── Disable directory listing ────────────────────────────────────────────────
Options -Indexes
